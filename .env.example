# App
APP_ENV=local
APP_DEBUG=true
PORT=3000
SESSION_SECRET=change_me_to_a_long_random_secret
JWT_SECRET=change_me_to_a_different_long_random_secret

# Leave empty when app runs from domain root or PHP built-in server (recommended)
# Example: http://localhost:8000 or https://your-app.onrender.com
BASE_URL=

# Database (Render + Railway MySQL example)
DB_TYPE=mysql
DB_HOST=centerbeam.proxy.rlwy.net
DB_PORT=54756
DB_NAME=railway
DB_USER=root
DB_PASS=your_railway_password
DB_PASSWORD=your_railway_password
DB_SSL=true
DB_CHARSET=utf8mb4
# Optional persistent uploads directory (recommended on Render disk)
# Example: /var/data/uploads
UPLOADS_DIR=

# Optional legacy aliases (keep same values if used)
MYSQLHOST=centerbeam.proxy.rlwy.net
MYSQLPORT=54756
MYSQLUSER=root
MYSQLPASSWORD=your_railway_password
MYSQLDATABASE=railway

# Optional auth schema mapping (set only if your DB schema uses different names)
AUTH_USERS_TABLE=users
AUTH_USER_ID_COLUMN=id
AUTH_USERNAME_COLUMN=username
AUTH_EMAIL_COLUMN=email
AUTH_PASSWORD_COLUMN=password_hash
AUTH_ROLE_COLUMN=role
AUTH_NAME_COLUMN=name
AUTH_TEAM_COLUMN=team
AUTH_PROFILE_PICTURE_COLUMN=profile_picture

# Auth mode (session by default). Set to "jwt" only if JWT is fully configured.
AUTH_STRATEGY=session
# JWT_SECRET=replace_with_long_random_value_if_using_jwt

# Optional alternative (if your provider gives a full URL)
# DATABASE_URL=mysql://username:password@host:3306/database_name
