# App
APP_ENV=local
APP_DEBUG=true
PORT=3000
SESSION_SECRET=change_me_to_a_long_random_secret

# Leave empty when app runs from domain root or PHP built-in server (recommended)
# Example: http://localhost:8000 or https://your-app.onrender.com
BASE_URL=

# Database (preferred: set these in Render Environment Variables)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cc_gsite_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# JavaScript backend variables (mysql2 createPool)
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=cc_gsite_db

# Optional alternative (if your provider gives a full URL)
# DATABASE_URL=mysql://username:password@host:3306/database_name
